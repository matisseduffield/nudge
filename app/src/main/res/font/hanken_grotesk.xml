<?xml version="1.0" encoding="utf-8"?>
<!-- The page's font, for the alarm page. Static cuts of Hanken Grotesk's variable font
     from google/fonts (SIL OFL, licence in web/fonts/OFL.txt). Bold text gets the 600,
     the weight the page uses for bold. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font android:font="@font/hanken_grotesk_regular" android:fontStyle="normal" android:fontWeight="400" />
    <font android:font="@font/hanken_grotesk_semibold" android:fontStyle="normal" android:fontWeight="600" />
</font-family>
