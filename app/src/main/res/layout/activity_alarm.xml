<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/alarm_bg"
    android:fitsSystemWindows="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- The time now, like a phone's own alarm. -->
    <TextView
        android:id="@+id/alarm_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/hanken_grotesk"
        android:textColor="@color/alarm_muted"
        android:textSize="20sp" />

    <!-- A fixed box, so a long title shrinks to fit rather than being cut short. It sits
         at the bottom of its box, just over the line below it. AlarmFace keeps its lines
         to what the box holds. -->
    <TextView
        android:id="@+id/alarm_title"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:autoSizeMaxTextSize="34sp"
        android:autoSizeMinTextSize="@dimen/alarm_title_min"
        android:autoSizeStepGranularity="1sp"
        android:autoSizeTextType="uniform"
        android:ellipsize="end"
        android:fontFamily="@font/hanken_grotesk"
        android:gravity="center_horizontal|bottom"
        android:lineSpacingMultiplier="1.05"
        android:maxLines="4"
        android:textColor="@color/alarm_ink"
        android:textSize="34sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/alarm_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:fontFamily="@font/hanken_grotesk"
        android:gravity="center"
        android:maxLines="2"
        android:textColor="@color/alarm_muted"
        android:textSize="17sp" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/alarm_done"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@drawable/alarm_primary"
        android:fontFamily="@font/hanken_grotesk"
        android:gravity="center"
        android:text="@string/alarm_done"
        android:textColor="@color/alarm_bg"
        android:textSize="19sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/alarm_ten"
            android:autoSizeMaxTextSize="16sp"
            android:autoSizeMinTextSize="11sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:maxLines="1"
            android:paddingHorizontal="8dp"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:background="@drawable/alarm_secondary"
            android:fontFamily="@font/hanken_grotesk"
            android:gravity="center"
            android:text="@string/alarm_ten"
            android:textColor="@color/alarm_ink"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/alarm_hour"
            android:autoSizeMaxTextSize="16sp"
            android:autoSizeMinTextSize="11sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:maxLines="1"
            android:paddingHorizontal="8dp"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:background="@drawable/alarm_secondary"
            android:fontFamily="@font/hanken_grotesk"
            android:gravity="center"
            android:text="@string/alarm_hour"
            android:textColor="@color/alarm_ink"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/alarm_stop"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/hanken_grotesk"
        android:gravity="center"
        android:text="@string/alarm_stop"
        android:textColor="@color/alarm_muted"
        android:textSize="15sp" />
</LinearLayout>
</FrameLayout>
