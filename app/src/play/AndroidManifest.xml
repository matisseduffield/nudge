<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Reminders ring on the minute once the person allows it. Android 14 and later
         start with this off, so the page explains it and opens the setting. Until
         then reminders still ring, just later. See BuildConfig.ASK_EXACT_ALARM. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
</manifest>
